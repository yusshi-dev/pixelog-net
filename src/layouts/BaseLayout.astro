---
import "../styles/global.css";
import { SITE } from "../consts";
import { formatDocumentTitle } from "../utils/title";

interface Props {
  /** ページ固有のタイトル。省略するとサイト名のみになる（ホーム用） */
  documentTitle?: string;
  /** meta description */
  description?: string;
  /** OGP 画像（絶対URL）。省略すると汎用画像（SITE.ogImage）になる */
  ogImage?: string;
  /** og:type */
  ogType?: "website" | "article";
}

const {
  documentTitle,
  description = SITE.description,
  ogImage = new URL(SITE.ogImage, SITE.url).href,
  ogType = "website",
} = Astro.props;

const documentTitleText = formatDocumentTitle(documentTitle);
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitleText}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={documentTitleText} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitleText} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/atom.xml" />

    {/* 描画前に配色を確定してちらつきを防ぐ */}
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("pixelog-theme");
        } catch (e) {}
        var os = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        if ((saved || os) === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
  </head>

  <body class="bg-canvas font-sans text-m leading-[1.9] text-ink antialiased">
    <slot />
  </body>
</html>
