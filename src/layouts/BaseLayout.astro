---
import "../styles/global.css";
import { SITE } from "../consts";
import { formatDocumentTitle } from "../utils/title";

interface Props {
  /** ページ固有のタイトル。省略するとサイト名のみになる（ホーム用） */
  documentTitle?: string;
  /** meta description */
  description?: string;
}

const { documentTitle, description = SITE.description } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <title>{formatDocumentTitle(documentTitle)}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@500;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/atom.xml" />

    {/* 描画前に配色を確定してちらつきを防ぐ */}
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("pixelog-theme");
        } catch (e) {}
        var os = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        if ((saved || os) === "dark") document.documentElement.classList.add("dark");
      })();
    </script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5NYKFVQ1GE"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5NYKFVQ1GE');
    </script>
  </head>

  <body class="bg-canvas font-sans text-[1.0625rem] leading-[1.9] text-ink antialiased">
    <slot />
  </body>
</html>
