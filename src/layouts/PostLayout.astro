---
import SiteLayout from "./SiteLayout.astro";
import PostMeta from "../components/PostMeta.astro";
import TagLinks from "../components/TagLinks.astro";
import { getExcerpt } from "../utils/excerpt";
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const description = getExcerpt(post, 120);
---

<SiteLayout documentTitle={post.data.title} description={description} current="posts">
  <article>
    <PostMeta publishedAt={post.data.published_at} category={post.data.category} />

    <h1 class="mt-3 text-[1.5rem] font-bold leading-snug tracking-[-0.015em] text-ink sm:text-[1.75rem]">
      {post.data.title}
    </h1>

    <div class="prose mt-9">
      <slot />
    </div>

    <footer class="mt-14 flex flex-wrap items-baseline gap-x-5 gap-y-2">
      <span class="font-mono text-[0.8125rem] text-ink3">タグ</span>
      <TagLinks tags={post.data.tags ?? []} />
    </footer>
  </article>
</SiteLayout>
