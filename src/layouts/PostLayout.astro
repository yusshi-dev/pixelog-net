---
import SiteLayout from "./SiteLayout.astro";
import AdUnit from "../components/AdUnit.astro";
import PostMeta from "../components/PostMeta.astro";
import PostPager from "../components/PostPager.astro";
import TagLinks from "../components/TagLinks.astro";
import { getExcerpt } from "../utils/excerpt";
import { getOgImage } from "../utils/ogp";
import type { Post } from "../utils/posts";

interface Props {
  post: Post;
  older?: Post;
  newer?: Post;
}

const { post, older, newer } = Astro.props;
const description = getExcerpt(post, 120);
const ogImage = await getOgImage(post);
---

<SiteLayout
  documentTitle={post.data.title}
  description={description}
  ogImage={ogImage}
  ogType="article"
  current="posts"
>
  <article>
    <PostMeta publishedAt={post.data.published_at} category={post.data.category} />

    <h1 class="mt-3 text-l3 font-bold leading-snug tracking-[-0.015em] text-ink">
      {post.data.title}
    </h1>

    <div class="prose mt-9">
      <slot />
    </div>

    {
      (post.data.tags?.length ?? 0) > 0 && (
        <footer class="mt-14 flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="font-mono text-s2 text-ink3">タグ</span>
          <TagLinks tags={post.data.tags ?? []} />
        </footer>
      )
    }

    <div class="my-8">
      <AdUnit slot="4141857270" label="記事下広告" />
    </div>

    <PostPager older={older} newer={newer} />
  </article>
</SiteLayout>
