---
interface Props {
  title: string;
  count?: number;
}

const { title, count } = Astro.props;
---

<header class="mb-9 flex flex-wrap items-baseline gap-x-3 gap-y-1">
  <h1 class="text-l3 font-bold leading-snug tracking-[-0.015em] text-ink">
    {title}
  </h1>
  {count !== undefined && <span class="text-s1 text-ink3">{count}件</span>}
</header>
