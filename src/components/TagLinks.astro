---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<span class="flex flex-wrap gap-2">
  {
    tags.map((tag) => (
      <a
        href={`/tags/${tag}/`}
        class="rounded-full border border-line px-2.5 py-1 text-s2 text-ink2 transition hover:border-brandink hover:text-brandink"
      >
        {tag}
      </a>
    ))
  }
</span>
