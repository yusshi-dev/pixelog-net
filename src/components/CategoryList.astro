---
import type { Counted } from "../utils/posts";

interface Props {
  categories: Counted[];
}

const { categories } = Astro.props;
---

<nav aria-label="カテゴリー">
  {
    categories.map((category) => (
      <a
        href={`/categories/${category.name}/`}
        class="flex items-baseline gap-2 py-1.5 text-s1 text-ink2 transition hover:text-brandink"
      >
        <span>{category.name}</span>
        <span class="leader flex-1" aria-hidden="true" />
        <span class="font-mono text-s2 text-ink3">{category.count}</span>
      </a>
    ))
  }
</nav>
