---
import type { Post } from "../utils/posts";
import { getPostSlug } from "../utils/slug";

interface Props {
  /** ひとつ前（古い）記事 */
  older?: Post;
  /** ひとつ次（新しい）記事 */
  newer?: Post;
}

const { older, newer } = Astro.props;
---

{
  (older || newer) && (
    <nav
      class="mt-14 grid gap-x-8 gap-y-8 border-t border-line pt-9 sm:grid-cols-2"
      aria-label="前後の記事"
    >
      {newer ? (
        <a href={`/posts/${getPostSlug(newer)}/`} class="group flex flex-col gap-1.5">
          <span class="font-mono text-s3 text-ink3"><span aria-hidden="true">«</span> Newer</span>
          <span class="text-s1 font-bold leading-snug text-ink2 transition group-hover:text-brandink">
            {newer.data.title}
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}

      {older ? (
        <a
          href={`/posts/${getPostSlug(older)}/`}
          class="group flex flex-col gap-1.5 sm:items-end sm:text-right"
        >
          <span class="font-mono text-s3 text-ink3">Older <span aria-hidden="true">»</span></span>
          <span class="text-s1 font-bold leading-snug text-ink2 transition group-hover:text-brandink">
            {older.data.title}
          </span>
        </a>
      ) : (
        <span aria-hidden="true" />
      )}
    </nav>
  )
}
