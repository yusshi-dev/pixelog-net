---
import ActivityChart from "./ActivityChart.astro";
import ArchiveSelect from "./ArchiveSelect.astro";
import CategoryList from "./CategoryList.astro";
import RecentPostList from "./RecentPostList.astro";
import SearchBox from "./SearchBox.astro";
import SidebarSection from "./SidebarSection.astro";
import TagCloud from "./TagCloud.astro";
import { SIDEBAR_LINKS } from "../consts";
import type { SiteSummary } from "../utils/site";

interface Props {
  summary: SiteSummary;
}

const { summary } = Astro.props;

// サイドバーは短く保ちたいので、タグは上位のみ。全件は /tags/ で見せる
const SIDEBAR_TAG_LIMIT = 15;
---

<aside class="space-y-11 lg:pt-1" aria-label="サイドバー">
  <SidebarSection heading="記録の推移">
    <ActivityChart
      yearActivity={summary.yearActivity}
      totalPosts={summary.totalPosts}
      firstPostAt={summary.firstPostAt}
      lastPostAt={summary.lastPostAt}
    />
  </SidebarSection>

  <SidebarSection heading="カテゴリー">
    <CategoryList categories={summary.categories} />
  </SidebarSection>

  <SidebarSection heading="タグ">
    <TagCloud tags={summary.tags} limit={SIDEBAR_TAG_LIMIT} />
    <a
      href="/tags/"
      class="mt-3 inline-block text-[0.875rem] text-ink2 transition hover:text-brandink"
    >
      すべてのタグ →
    </a>
  </SidebarSection>

  <SidebarSection heading="年月" forId="archive-year">
    <ArchiveSelect years={summary.years} />
  </SidebarSection>

  <SidebarSection heading="最近の投稿">
    <RecentPostList posts={summary.recentPosts} />
  </SidebarSection>

  <SidebarSection heading="リンク">
    <ul class="space-y-2.5 text-[0.9375rem] text-ink2">
      {
        SIDEBAR_LINKS.map((link) => (
          <li>
            <a href={link.href} class="transition hover:text-brandink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </SidebarSection>

  <SidebarSection heading="検索" forId="search-input">
    <SearchBox />
  </SidebarSection>
</aside>
