---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import PageHeading from "../../../components/PageHeading.astro";
import PostList from "../../../components/PostList.astro";
import Pagination from "../../../components/Pagination.astro";
import { POSTS_PER_PAGE } from "../../../consts";
import { getCategories, getPublishedPosts, postsInCategory } from "../../../utils/posts";

export async function getStaticPaths({ paginate }) {
  const posts = await getPublishedPosts();

  return getCategories(posts).flatMap((category) =>
    paginate(postsInCategory(posts, category), {
      params: { category },
      pageSize: POSTS_PER_PAGE,
      props: { category },
    }),
  );
}

const { page, category } = Astro.props;
---

<SiteLayout documentTitle={category} current="categories" description={`カテゴリー「${category}」の記事一覧`}>
  <PageHeading label="カテゴリー" title={category} count={page.total} />

  <PostList posts={page.data} />

  <Pagination
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    basePath={`/categories/${category}/`}
  />
</SiteLayout>
