---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PageHeading from "../../components/PageHeading.astro";
import PostList from "../../components/PostList.astro";
import { getJstYear } from "../../utils/datetime";
import { getYearPath } from "../../utils/slug";
import { getPublishedPosts, getYears } from "../../utils/posts";

const posts = await getPublishedPosts();

// 年ごとにまとめて表示する。各年は年別ページ（/archive/<年>/）にも分かれている
const years = getYears(posts);

const groups = years.map((year) => ({
  year,
  posts: posts.filter((post) => getJstYear(post.data.published_at) === year),
}));
---

<SiteLayout documentTitle="アーカイブ" current="posts">
  <PageHeading label="アーカイブ" title="すべての記録" count={posts.length} />

  <div class="space-y-16">
    {
      groups.map((group) => (
        <section>
          <h2 class="mb-2 font-mono text-s2 font-medium tracking-[0.1em] text-ink2">
            <a href={getYearPath(group.year)} class="transition hover:text-brandink">
              {group.year}
            </a>
          </h2>
          <PostList posts={group.posts} titleTag="h3" />
        </section>
      ))
    }
  </div>
</SiteLayout>
