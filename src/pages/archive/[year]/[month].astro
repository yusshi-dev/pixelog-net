---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import PageHeading from "../../../components/PageHeading.astro";
import PostList from "../../../components/PostList.astro";
import { getJstYearMonth } from "../../../utils/datetime";
import { getPublishedPosts, type Post } from "../../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  // 投稿がある月だけをページにする（空の月のURLを量産しない）
  const months = [
    ...new Set(
      posts.map((post) => {
        const { year, month } = getJstYearMonth(post.data.published_at);
        return `${year}-${String(month).padStart(2, "0")}`;
      }),
    ),
  ];

  return months.map((key) => {
    const [year, month] = key.split("-");

    return {
      params: { year, month },
      props: {
        year: Number(year),
        month: Number(month),
        posts: posts.filter((post) => {
          const published = getJstYearMonth(post.data.published_at);
          return published.year === Number(year) && published.month === Number(month);
        }),
      },
    };
  });
}

interface Props {
  year: number;
  month: number;
  posts: Post[];
}

const { year, month, posts } = Astro.props;
---

<SiteLayout documentTitle={`${year}年${month}月の記録`} current="posts">
  <PageHeading title={`${year}年${month}月`} count={posts.length} />

  <PostList posts={posts} />
</SiteLayout>
