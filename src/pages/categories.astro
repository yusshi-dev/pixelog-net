---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDateYear } from "../utils/datetime";
import { getPostSlug } from "../utils/slug";
import { getPublishedPosts, getCategories } from "../utils/posts";

const posts = await getPublishedPosts();
const categories = getCategories(posts);
const pageTitle = "Categories";
---

<BaseLayout documentTitle="カテゴリー">
  <p class="page-title">{pageTitle}</p>

  <div class="categories-meta">
    <span>{categories.length} categories</span>
    <span class="categories-meta-sep">·</span>
    <span>{posts.length} articles</span>
  </div>

  <div class="category-cloud">
    {
      categories.map((category) => {
        const count = posts.filter((post) => post.data.category === category).length;
        return (
          <a href={`#${category}`} class="category-cloud-item">
            {category}
            <span class="cc-count">{count}</span>
          </a>
        );
      })
    }
  </div>

  <hr class="divider" />

  <div class="category-detail-list">
    {
      categories.map((category) => {
        const filteredPosts = posts.filter((post) => post.data.category === category);
        return (
          <div class="category-group" id={category}>
            <div class="category-group-heading">
              <span class="category-group-name">{category}</span>
              <span class="category-group-count">{filteredPosts.length} articles</span>
            </div>
            {
              filteredPosts.map((post) => (
                <a class="category-article-row" href={`/posts/${getPostSlug(post)}/`}>
                  <div class="category-article-title">{post.data.title}</div>
                  <time class="category-article-date">{formatDateYear(post.data.published_at)}</time>
                </a>
              ))
            }
          </div>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .categories-meta {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    margin-bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .categories-meta-sep { color: var(--line-strong); }

  .category-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 3rem;
  }
  .category-cloud-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    padding: 0.3em 0.85em;
    color: var(--ink-mid);
    text-decoration: none;
  }
  .category-cloud-item:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .cc-count {
    font-size: 0.56rem;
    color: var(--ink-faint);
  }
  .category-cloud-item:hover .cc-count { color: rgba(247, 245, 242, 0.5); }

  .category-detail-list { display: flex; flex-direction: column; }
  .category-group { padding: 4rem 0 0.3rem; }
  .category-group:first-child { padding-top: 0; }
  .category-group-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .category-group-name {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-alt);
  }
  .category-group-count {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
  .category-article-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    align-items: baseline;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }
  .category-article-row:hover .category-article-title { color: var(--accent-alt); }
  .category-article-title {
    font-size: 0.88rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .category-article-date {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    white-space: nowrap;
    align-self: start;
    padding-top: 0.15rem;
  }
</style>
